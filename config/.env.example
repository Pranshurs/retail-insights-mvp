# Copy to config/.env (git-ignored). Everything is optional for a local start.

# Store
STORE_TZ=Asia/Kolkata
DATABASE_URL=sqlite:///data/store.db
# SECRET_KEY=           # generated and stored on first run if unset

# Machine API (POS sync agent, /api/stock). Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# WhatsApp Cloud API. Without these, deals use a mock sender (nothing is sent).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_SEND_PAUSE_S=0.2

# Extra CSV column names, if your POS export uses unusual headers
# COLUMN_MAP=product:Item Description,quantity:Qty Sold
